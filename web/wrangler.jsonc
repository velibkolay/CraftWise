// wow.velikopter.com (#95). Deploy steps: docs/web-deploy.md (#99).
// No secrets here. ACCESS_AUD is set in the Cloudflare dashboard (keep_vars keeps it on deploy).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "craftwise-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-15",
	"keep_vars": true,
	// The site's scripts (site/*.ts) are bundled into public/assets by esbuild before every deploy and dev run.
	"build": { "command": "npm run build", "watch_dir": "site" },
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// The Worker answers the API, checks the Access login before serving /me, and serves the
		// item page (public/item.html) for /item/<id>.
		"run_worker_first": ["/api/*", "/me", "/me/*", "/item/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "craftwise",
			// Placeholder: replace with the ID of the D1 database created in docs/web-deploy.md.
			"database_id": "bdc6530b-02bc-4f88-a41b-5e03e68249e8",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"ACCESS_TEAM_DOMAIN": "velikopter.cloudflareaccess.com"
	},
	// Daily retention (raw points, scan log, rate-limit and usage rows). Cron triggers are free.
	"triggers": { "crons": ["17 3 * * *"] },
	"observability": { "enabled": true }
}
